# Copy to .env and fill in your values
# cp .env.example .env

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama (default, local) | openai | claude
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Set these to switch provider:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Target repo (mounted into kio3/kio5 containers) ──────────────────────────
# HOST_REPO_PATH=./examples/buggy_fastapi_repo
HOST_REPO_PATH=./examples

# ── HITL ─────────────────────────────────────────────────────────────────────
HITL_APPROVAL_TIMEOUT=300

# ── Transport ─────────────────────────────────────────────────────────────────
# Set USE_NATS=false to use HTTP-only mode (no NATS server required)
USE_NATS=true
