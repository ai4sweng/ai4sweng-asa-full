# Copy to .env and fill in your values
# cp .env.example .env
#
# Port / host / URL strategy
# --------------------------
# Every service URL is computed from its host + port parts. You have two ways
# to configure a service location:
#
#   Option A — set individual parts (recommended):
#     LM_ENGINE_HOST=lm_engine       ← Docker service name
#     LM_ENGINE_PORT=8001
#
#   Option B — override the full URL directly:
#     LM_ENGINE_URL=http://lm_engine:8001
#
#   Option B takes precedence over Option A.

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama (default, local) | openai | anthropic | mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Set these to switch provider:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Target repo (mounted into kio3/kio5 containers) ──────────────────────────
HOST_REPO_PATH=./examples

# ── Service ports (defaults — change if these ports conflict locally) ─────────
# ORCHESTRATOR_PORT=8000
# LM_ENGINE_PORT=8001
# SESSION_MANAGER_PORT=8002
# REPORT_TOOL_PORT=8003
# DASHBOARD_PORT=3000
# VITE_DEV_PORT=5173

# ── Service hosts ─────────────────────────────────────────────────────────────
# Locally: leave as "localhost" (default).
# In Docker Compose: set to the container service name.
# LM_ENGINE_HOST=localhost
# SESSION_MANAGER_HOST=localhost
# REPORT_TOOL_HOST=localhost

# ── Full URL overrides (only needed if host/port parts are not enough) ────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
# NATS_URL=nats://nats:4222

# ── PostgreSQL connection parts ───────────────────────────────────────────────
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=enisalimerge
# POSTGRES_PASSWORD=enisalimerge
# POSTGRES_DB=enisalimerge

# ── NATS connection parts ─────────────────────────────────────────────────────
# NATS_HOST=localhost
# NATS_PORT=4222

# ── HITL ─────────────────────────────────────────────────────────────────────
HITL_APPROVAL_TIMEOUT=300

# ── Transport ─────────────────────────────────────────────────────────────────
# Set USE_NATS=false to use HTTP-only mode (no NATS server required)
USE_NATS=true

# ── NATS tuning (optional — defaults shown) ───────────────────────────────────
# NATS_STREAM_MAX_AGE=3600         # seconds — KIO_JOBS message TTL
# NATS_MAX_DELIVER=3               # max redelivery attempts
# NATS_FETCH_TIMEOUT=2.0           # seconds — pull-consumer poll interval
# NATS_RECONNECT_WAIT=2            # seconds between reconnect attempts
# NATS_MAX_RECONNECT_ATTEMPTS=10   # 0 = unlimited

# ── Platform timing (optional — defaults shown) ───────────────────────────────
# KIO_HEARTBEAT_INTERVAL=30        # seconds between KIO heartbeat publishes
# KIO_CAPABILITY_INTERVAL=60       # seconds between CAPABILITY_ANNOUNCEMENT publishes
# AGENT_STALE_THRESHOLD=90         # seconds without announcement → stale
# TIMEOUT_MONITOR_INTERVAL=5       # seconds between deadline sweeps
# SSE_QUEUE_MAXSIZE=256            # max buffered events per SSE client
# SSE_HEARTBEAT_INTERVAL=15        # seconds between SSE keepalive pings
# MAX_ACTIVE_SESSIONS_PER_USER=20  # concurrent session DoS limit
# KIO_SUBPROCESS_PIP_TIMEOUT=120   # seconds for pip install (kio7)
# KIO_SUBPROCESS_TEST_TIMEOUT=30   # seconds for pytest collect (kio7)

# ── CORS (optional — auto-built from DASHBOARD_PORT + VITE_DEV_PORT) ─────────
# CORS_ORIGINS=["https://app.example.com"]
